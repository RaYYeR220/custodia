# python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# node
node_modules/
.next/
out/
dist/
*.tsbuildinfo

# local runtime
.env
.env.local
.hydradb/
data/
*.log

# datasets and results are downloaded or produced, not vendored.
# `data/` above excludes eval/data entirely, and git will not look inside an
# excluded directory - so the directory has to be re-included before the
# dataset-provenance manifest can be tracked.
!eval/data/
eval/data/raw/
eval/data/*.json
!eval/data/manifest.json
eval/results/
tests/_cache/

# editor and scratch
.idea/
.vscode/
.DS_Store
scratch/
notes/
*-backup*
*.bundle
