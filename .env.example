# Copy to .env and fill in. Everything here has a working default except the
# language-model credentials, and the shipped demo runs without those.

# --- graph -------------------------------------------------------------------
HYDRA_URI=bolt://127.0.0.1:7687
HYDRA_TOKEN=local-development-token-32-bytes
CUSTODIA_CORPUS=demo

# --- language model ----------------------------------------------------------
# Any OpenAI-compatible endpoint works. Two that do:
#   OpenRouter  https://openrouter.ai/api/v1
#   Venice      https://api.venice.ai/api/v1
# The defaults match the models that produced the shipped response cache, so the
# walkthrough replays without credentials. Change them and you get live calls
# from the model you named instead - which is the point, but it needs a key.
CUSTODIA_LLM_BASE_URL=https://api.venice.ai/api/v1
CUSTODIA_LLM_API_KEY=
CUSTODIA_EXTRACT_MODEL=gemini-3-5-flash-lite
CUSTODIA_ANSWER_MODEL=gemini-3-7-flash

# Serve answers only from the shipped response cache - no credentials needed,
# which is how the demo corpus runs offline.
CUSTODIA_CACHE_ONLY=false
